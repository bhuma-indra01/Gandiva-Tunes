# ==========================================
# GANDIVA TUNES - CONFIGURATION
# Credits: Syko Reddy
# ==========================================

# Your Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Bot Owner Discord User ID (REQUIRED for /setavatar, /setbanner, /setname)
OWNER_ID=your_discord_user_id_here

# Default Command Prefix (Optional, default is !)
DEFAULT_PREFIX=!

# Spotify API Credentials (Optional - for enhanced Spotify playlist support)
# Get from: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Default Audio Volume (1-100, default is 80)
DEFAULT_VOLUME=80

# Auto-disconnect timeout in seconds when queue is empty (0 to disable)
IDLE_TIMEOUT=180
